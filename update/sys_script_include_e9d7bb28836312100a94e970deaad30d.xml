        <script><![CDATA[var NeeditUtils = Class.create();
NeeditUtils.prototype = {
	initialize: function () {
	},
	isPast: function (when_needed) {
		var rightnow = new GlideDateTime();
		var whenNeeded = new GlideDateTime(when_needed);
		if (whenNeeded.before(rightnow)) {
			return true;
		} else {
			return false;
		}
	},
	isDateToday: function () {
		var today = new GlideDateTime().getLocalDate();
		var isToday = new GlideDateTime(when_needed).getLocalDate();

		if (today.compareTo(isToday) == 0) {
			return true;
		} else{
			false;
		}

	},
	type: 'NeeditUtils'
};]]></script>
